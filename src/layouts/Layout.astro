---
import '~/styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const { title = 'Nikita Chistyakov', description = 'Personal portfolio.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="bg-bg text-ink antialiased font-sans">
    <slot />
  </body>
</html>
