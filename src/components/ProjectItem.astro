---
import type { ProjectEntry } from '~/data/profile';

export interface Props {
  entry: ProjectEntry;
}

const { entry } = Astro.props;
---

<article class="rounded-2xl border border-hairline bg-surface p-6">
  <h3 class="font-semibold">
    <a href={entry.href} class="hover:text-accent transition-colors" target="_blank" rel="noopener noreferrer">
      {entry.title}
    </a>
  </h3>
  <p class="mt-2 text-sm leading-relaxed text-muted">{entry.description}</p>
</article>
