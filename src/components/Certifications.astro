---
import { profile } from '~/data/profile';
---

<section class="reveal py-10" id="certifications">
  <h2 class="font-mono text-xs uppercase tracking-widest text-muted">Certifications</h2>
  <ul class="mt-3 list-disc space-y-1 pl-5 text-sm leading-relaxed">
    {profile.certifications.map((entry) => <li>{entry.name}</li>)}
  </ul>
</section>
