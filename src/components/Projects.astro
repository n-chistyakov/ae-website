---
import { profile } from '~/data/profile';
import ProjectItem from '~/components/ProjectItem.astro';
---

<section class="reveal py-10" id="projects">
  <h2 class="font-mono text-xs uppercase tracking-widest text-muted">Projects</h2>
  <div class="mt-4 grid gap-6 tablet:grid-cols-2">
    {profile.projects.map((entry) => <ProjectItem entry={entry} />)}
  </div>
</section>
