---
import { profile } from '~/data/profile';
import Icon from '~/components/Icon.astro';
---

<section class="reveal py-10" id="skills">
  <h2 class="font-mono text-xs uppercase tracking-widest text-muted">Skills / Stack</h2>

  <div class="mt-4 flex flex-wrap gap-2">
    {
      profile.skills.map((skill) => (
        <span class="rounded-full border border-hairline bg-surface px-3 py-1 text-sm">{skill}</span>
      ))
    }
  </div>

  <div class="mt-6 flex flex-wrap items-center gap-5">
    {
      profile.tools.map((tool) => (
        <span class="group relative inline-flex">
          <Icon name={tool.icon} class="h-9 w-9 transition-transform duration-200 ease-out group-hover:scale-125" />
          <span class="pointer-events-none absolute -top-8 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-md bg-ink px-2 py-1 text-xs text-white opacity-0 transition-opacity duration-150 group-hover:opacity-100">
            {tool.label}
          </span>
        </span>
      ))
    }
  </div>
</section>
