---
import { Image } from 'astro:assets';
import type { ExperienceEntry } from '~/data/profile';
import { initials } from '~/utils/text';

export interface Props {
  entry: ExperienceEntry;
}

const { entry } = Astro.props;
---

<article class="grid grid-cols-[48px_1fr] gap-4 py-6">
  {
    entry.logo ? (
      <div class="flex h-12 w-12 items-center justify-center overflow-hidden rounded-lg bg-white">
        <Image src={entry.logo} width={96} height={96} fit="contain" alt={entry.company} class="h-full w-full" />
      </div>
    ) : (
      <div
        class="flex h-12 w-12 items-center justify-center rounded-lg text-sm font-semibold text-white"
        style={{ backgroundColor: entry.badgeColor }}
      >
        {initials(entry.company)}
      </div>
    )
  }

  <div>
    <h3 class="font-semibold">{entry.role}</h3>
    <p class="font-mono text-xs uppercase tracking-wide text-muted">
      {entry.company} · {entry.dateStart}–{entry.dateEnd}
    </p>
    <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed">
      {
        entry.bullets.map((b) => (
          <li>
            <strong>{b.lead}</strong> {b.text}
          </li>
        ))
      }
    </ul>
  </div>
</article>
